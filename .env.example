# SMTP (Hostinger) — copy to .env.local
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=info@osama-me.digital
SMTP_PASS=

# Search Console / Bing verification (optional, set on the production host)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# IndexNow (optional override; must match public/{key}.txt)
INDEXNOW_KEY=a8f3c1e92b4d6e7a0c5f8d1b3e6a9c24

# Google Ads conversion tracking (optional — set after Ads account is ready)
# Example ID format: AW-123456789
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Example label from Ads conversion action (not the full send_to string)
NEXT_PUBLIC_GOOGLE_ADS_LEAD_CONVERSION_LABEL=

# WhatsApp lead notifications (optional — notify Osama when a form is submitted)
# Default notify number is siteConfig.whatsapp (+971507276823)
WHATSAPP_NOTIFY_TO=+971507276823
#
# Easiest option — CallMeBot:
# 1) On WhatsApp, message the CallMeBot number and get your API key
#    (see https://www.callmebot.com/blog/free-api-whatsapp-messages/)
# 2) Set the key below
CALLMEBOT_API_KEY=
#
# Alternative — Meta WhatsApp Cloud API (business sender number required):
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
